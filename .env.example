# Get a free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any free (":free" suffix) OpenRouter model with <= 35B parameters.
# Default below is OpenAI gpt-oss-20b (free tier, 21B params, open-weight, Apache 2.0).
# Check https://openrouter.ai/models?max_price=0 for the current list of free models,
# since OpenRouter periodically rotates/retires free models (this project's original
# default, qwen/qwen-2.5-32b-instruct:free, was retired after this README was written
# - if this model is also gone by the time you read this, swap in whatever current
# ":free" model is <= 35B parameters; no code changes needed).
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional, used by OpenRouter for their leaderboard / rate-limit attribution. Safe to leave as-is.
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=MAP-Multiskill-agent

# How many candidate skills Skill Discovery returns to the Router. With 4 skills
# registered today, 4 effectively means "return everything" - that's fine; the value
# only starts to matter (and should be lowered, e.g. to 5-8) once many more skills
# are registered. See src/discovery/skill_discovery.py.
DISCOVERY_TOP_K=4
